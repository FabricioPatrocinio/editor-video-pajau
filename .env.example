# Copie para .env (cp .env.example .env) e preencha. O .env não vai para o Git.

# ---- Qual IA usar ----
# true  = Claude (Anthropic)   false = OpenAI
PAJAU_USE_CLAUDE=true

# ---- Claude ----
# Crie em https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# claude-opus-5-5 (melhor escolha, padrão) | claude-sonnet-5-5 (mais barato) | claude-haiku-5-5 (bem mais barato)
ANTHROPIC_MODEL=claude-opus-5-5
# Profundidade do raciocínio: low | medium | high | xhigh | max
PAJAU_CLAUDE_EFFORT=high

# ---- OpenAI (usado quando PAJAU_USE_CLAUDE=false) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- Controle de custo ----
# Bloqueia novas análises quando o gasto estimado do dia passar deste valor (só modelos Claude conhecidos)
PAJAU_AI_DAILY_LIMIT_USD=2.00
# Quantos candidatos a análise local encontra e quantos vão para a IA (com imagens)
PAJAU_MAX_CANDIDATES=60
PAJAU_AI_MAX_CANDIDATES=40
PAJAU_AI_MAX_IMAGE_CANDIDATES=25

# ---- Transcrição local (recomendado) ----
# Transcreve só os trechos candidatos, no seu computador, com faster-whisper
PAJAU_TRANSCRIBE=true
# tiny | base | small | medium  (maior = melhor e mais lento)
PAJAU_WHISPER_MODEL=small
PAJAU_WHISPER_LANGUAGE=pt
